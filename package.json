{
  "name": "nps-map",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "infisical run --env=dev -- next dev",
    "build": "next build",
    "start": "infisical run --env=dev -- next start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "seed:boundaries": "tsx scripts/seed-boundaries.ts",
    "seed:details": "infisical run --env=dev -- tsx scripts/seed-details.ts",
    "seed": "pnpm seed:boundaries && pnpm seed:details && pnpm build:overview",
    "build:overview": "infisical run --env=dev -- tsx scripts/build-overview.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@vercel/analytics": "^1.6.1",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^0.577.0",
    "maplibre-gl": "^6.16.0",
    "next": "16.4.3",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "react-map-gl": "^8.1.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@10.30.3+sha512.c961d1e0a2d8e354ecaa5166b822516668b7f44cb5bd95122d590dd81922f606f5473b6d23ec4a5be05e7fcd18e8488d47d978bbe981872f1145d06e9a740017"
}
